# Cursor AI Context Exclusions
# Files and directories to exclude from Cursor's AI indexing and context

# Jekyll build outputs and cache
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Editor and IDE files
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# Node modules (if added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.min.js
*.min.css

# Temporary files
*.tmp
*.temp
*.log
*.cache
.cache/

# Environment and sensitive files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup
*_backup

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude-specific files (keep for reference but don't index)
.claude/
.clauderc
